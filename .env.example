DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.rncoptajwdtueqvtbgkw.supabase.co:5432/postgres
SUPABASE_URL=https://rncoptajwdtueqvtbgkw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-side only -- NEVER expose this through frontend/Vite env vars (VITE_*) or any
# client-facing config. Elevated credential (bypasses Row Level Security) used for Supabase
# Storage admin REST calls: signed upload/download URLs for both Attachment Storage (chat,
# /attachments/upload-url, /attachment-url) and Resource Storage (Group Resources,
# /resources/upload-url, /resources/files/{id}/download-url) -- see
# Settings.supabase_server_key. Get this from Project Settings -> API Keys -> Secret keys
# (starts with sb_secret_...). Preferred over SUPABASE_SERVICE_ROLE_KEY below.
SUPABASE_SECRET_KEY=
# Legacy elevated key (JWT). Only used as a fallback if SUPABASE_SECRET_KEY is unset -- not
# required for new setups.
SUPABASE_SERVICE_ROLE_KEY=
# Seconds a signed attachment download URL stays valid.
ATTACHMENT_DOWNLOAD_URL_EXPIRES_IN=300

# LiveKit
LIVEKIT_URL=wss://study-together-bgl89n83.livekit.cloud
LIVEKIT_API_KEY=APIrzBEo3kZdnbT
LIVEKIT_API_SECRET=

# CORS: comma-separated list of origins allowed to call this API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Invitations
# Seconds an invitation CODE stays valid (default 5 minutes). Email invitations use a much
# longer, separately configurable TTL (default 7 days) since they're checked whenever the
# recipient next opens their inbox, not redeemed live.
INVITATION_CODE_TTL_SECONDS=300
INVITATION_EMAIL_TTL_SECONDS=604800
# Origin used to build the /invitations/<token> deep link embedded in invitation emails.
FRONTEND_BASE_URL=http://localhost:5173

# Email delivery (optional). If SMTP_HOST is unset, invitation emails are logged to the
# server console instead of sent -- see app/core/email_service.py. Works with any provider
# that exposes a plain SMTP endpoint (Gmail, SendGrid, Mailgun, Postmark, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=

# AI roadmap suggestions (optional). AI_PROVIDER picks which service is called --
# "anthropic" (default) or "gemini"; only that provider's key needs to be set. Leave both
# keys unset to disable the "suggest with AI" button (endpoint returns 503).
AI_PROVIDER=anthropic
# Get a key at https://console.anthropic.com/ (paid; no ongoing free tier)
ANTHROPIC_API_KEY=
# Get a key at https://aistudio.google.com/apikey (has a free tier)
GEMINI_API_KEY=